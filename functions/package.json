    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "private": true,
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "glob": {
      "minimatch": "^11.0.5"
    },
    "rimraf": {
      "glob": "^14.0.2"
    }
  }
