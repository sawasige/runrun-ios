rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザープロフィールのフィールド検証
    // 表示名の条件は RunRun/Utilities/DisplayNameValidator.swift と揃えること
    function profileFields() {
      return ['displayName', 'email', 'iconName', 'avatarURL', 'fcmToken', 'createdAt'];
    }

    function isValidDisplayName(name) {
      // 文字列、前後に空白なし、制御文字（改行・タブ含む）なし、1〜20文字
      return name is string
        && name == name.trim()
        && name.matches('[^\\p{Cc}]{1,20}');
    }

    // displayName 以外のフィールドの型チェック
    function isValidProfileFields(data) {
      return (!('email' in data) || data.email == null || data.email is string)
        && (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 50))
        && (!('avatarURL' in data) || (data.avatarURL is string && data.avatarURL.size() <= 2048))
        && (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 4096))
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // ユーザープロフィール: 自分のみ書き込み可能
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId
        && request.resource.data.keys().hasOnly(profileFields())
        && isValidDisplayName(request.resource.data.displayName)
        && isValidProfileFields(request.resource.data);
      // 更新は既知のフィールドのみ変更可（過去に書かれた未知のフィールドは残っていてもよい）。
      // 表示名の検証は表示名を変更するときだけ行う。ルール導入前に保存された条件外の名前が
      // あっても、fcmToken 更新などの他の操作を止めないため
      allow update: if request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields())
        && (!('displayName' in request.resource.data.diff(resource.data).affectedKeys())
            || isValidDisplayName(request.resource.data.displayName))
        && isValidProfileFields(request.resource.data);
      allow delete: if request.auth.uid == userId;

      // フレンドリスト
      match /friends/{friendId} {
        allow read: if request.auth != null;
        // 自分のリスト、または相手のリストから自分を削除する場合
        allow write: if request.auth.uid == userId || request.auth.uid == friendId;
      }

      // 目標: 自分のみ読み書き可能
      match /goals/{goalId} {
        allow read, write: if request.auth.uid == userId;
      }

      // ブロックしたユーザー: 本人だけが読み書きできる。
      // 相手からは見えないが、friendRequests のルールが exists() で参照して申請を止める
      match /blocks/{blockedId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId
          && blockedId != userId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt is timestamp;
        allow delete: if request.auth.uid == userId;
      }
    }

    // ラン記録: 自分のみ書き込み可能
    match /runs/{runId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // フレンドリクエスト
    function isBlockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    function friendRequestFields() {
      return ['fromUserId', 'fromDisplayName', 'toUserId', 'createdAt', 'status'];
    }

    function isValidFriendRequest(data) {
      return data.keys().hasOnly(friendRequestFields())
        && data.fromUserId is string
        && data.toUserId is string
        && data.fromUserId != data.toUserId
        && data.fromDisplayName is string
        && data.createdAt is timestamp
        && data.status in ['pending', 'accepted', 'rejected'];
    }

    function isParticipant(data) {
      return request.auth != null
        && (request.auth.uid == data.fromUserId || request.auth.uid == data.toUserId);
    }

    match /friendRequests/{requestId} {
      // 当事者のみ読める（クエリは fromUserId か toUserId で絞ること）
      allow read: if isParticipant(resource.data);

      // 新規申請: 送信者本人、pending、どちらもブロックしていないこと
      allow create: if request.auth.uid == request.resource.data.fromUserId
        && isValidFriendRequest(request.resource.data)
        && request.resource.data.status == 'pending'
        && !isBlockedEitherWay(request.auth.uid, request.resource.data.toUserId);

      // 更新は 3 パターン:
      //  1. 受信者が承認/拒否する、または送信者が取り下げる（status のみ変更）
      //  2. 送信者が再申請する（createdAt と status を pending に戻す）
      //  3. 逆方向の古い申請を from/to を入れ替えて再利用する（元の受信者が新しい送信者になる）
      allow update: if isValidFriendRequest(request.resource.data)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && (
              (request.auth.uid == resource.data.toUserId
                && request.resource.data.status in ['accepted', 'rejected'])
              || (request.auth.uid == resource.data.fromUserId
                && request.resource.data.status == 'rejected')
            )
          )
          || (
            request.auth.uid == resource.data.fromUserId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt', 'status'])
            && request.resource.data.status == 'pending'
            && !isBlockedEitherWay(request.auth.uid, resource.data.toUserId)
          )
          || (
            request.auth.uid == resource.data.toUserId
            && request.resource.data.fromUserId == request.auth.uid
            && request.resource.data.toUserId == resource.data.fromUserId
            && request.resource.data.status == 'pending'
            && !isBlockedEitherWay(request.auth.uid, resource.data.fromUserId)
          )
        );

      // 削除は当事者のみ
      allow delete: if isParticipant(resource.data);
    }

    // 通報: クライアントは作成のみ。確認と対応は Firebase コンソールから行う（OPERATIONS.md 参照）
    function reportReasons() {
      return ['inappropriate_name', 'inappropriate_photo', 'harassment', 'spam', 'other'];
    }

    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'reporterId', 'reportedUserId', 'reportedDisplayName', 'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.reportedUserId))
        && request.resource.data.reportedDisplayName is string
        && request.resource.data.reportedDisplayName.size() <= 100
        && request.resource.data.reason in reportReasons()
        && (!('details' in request.resource.data)
            || (request.resource.data.details is string && request.resource.data.details.size() <= 2000))
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;
    }
  }
}
