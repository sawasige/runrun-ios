rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザープロフィールのフィールド検証
    // 表示名の条件は RunRun/Utilities/DisplayNameValidator.swift と揃えること
    function profileFields() {
      return ['displayName', 'email', 'iconName', 'avatarURL', 'fcmToken', 'createdAt'];
    }

    function isValidDisplayName(name) {
      // 文字列、前後に空白なし、制御文字（改行・タブ含む）なし、1〜20文字
      return name is string
        && name == name.trim()
        && name.matches('[^\\p{Cc}]{1,20}');
    }

    function isValidProfile(data) {
      return (!('displayName' in data) || isValidDisplayName(data.displayName))
        && (!('email' in data) || data.email == null || data.email is string)
        && (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 50))
        && (!('avatarURL' in data) || (data.avatarURL is string && data.avatarURL.size() <= 2048))
        && (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 4096))
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // ユーザープロフィール: 自分のみ書き込み可能
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId
        && 'displayName' in request.resource.data
        && request.resource.data.keys().hasOnly(profileFields())
        && isValidProfile(request.resource.data);
      // 更新は既知のフィールドのみ変更可（過去に書かれた未知のフィールドは残っていてもよい）
      allow update: if request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields())
        && isValidProfile(request.resource.data);
      allow delete: if request.auth.uid == userId;

      // フレンドリスト
      match /friends/{friendId} {
        allow read: if request.auth != null;
        // 自分のリスト、または相手のリストから自分を削除する場合
        allow write: if request.auth.uid == userId || request.auth.uid == friendId;
      }

      // 目標: 自分のみ読み書き可能
      match /goals/{goalId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // ラン記録: 自分のみ書き込み可能
    match /runs/{runId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // フレンドリクエスト: 認証済みユーザーならアクセス可能
    match /friendRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
  }
}
